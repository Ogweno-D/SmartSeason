{
    "info": {
      "name": "SmartSeason API",
      "_postman_id": "a1b2c3d4-5678-9abc-def0-1234567890ab",
      "description": "Auth + Fields + Observations API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "baseUrl",
        "value": "http://localhost:4000"
      },
      {
        "key": "accessToken",
        "value": ""
      },
      {
        "key": "refreshToken",
        "value": ""
      }
    ],
    "item": [
      {
        "name": "Health Check",
        "request": {
          "method": "GET",
          "url": "{{baseUrl}}/api/health"
        }
      },
      {
        "name": "Register User",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@smartseason.com\",\n  \"password\": \"123456\",\n  \"role\": \"agent\"\n}"
          },
          "url": "{{baseUrl}}/api/auth/register"
        }
      },
      {
        "name": "Login",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "pm.collectionVariables.set('accessToken', res.accessToken);",
                "pm.collectionVariables.set('refreshToken', res.refreshToken);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"test@smartseason.com\",\n  \"password\": \"123456\"\n}"
          },
          "url": "{{baseUrl}}/api/auth/login"
        }
      },
      {
        "name": "Get Fields",
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            }
          ],
          "url": "{{baseUrl}}/api/fields"
        }
      },
      {
        "name": "Create Field (Admin)",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"North Block A\",\n  \"crop_type\": \"Maize\",\n  \"planting_date\": \"2025-01-10\",\n  \"assigned_agent_id\": 1\n}"
          },
          "url": "{{baseUrl}}/api/fields"
        }
      },
      {
        "name": "Get Single Field",
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            }
          ],
          "url": "{{baseUrl}}/api/fields/1"
        }
      },
      {
        "name": "Update Stage",
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"stage\": \"Growing\"\n}"
          },
          "url": "{{baseUrl}}/api/fields/1/stage"
        }
      },
      {
        "name": "Add Observation",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"note\": \"Crop is healthy\"\n}"
          },
          "url": "{{baseUrl}}/api/fields/1/observations"
        }
      },
      {
        "name": "List Agents",
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}"
            }
          ],
          "url": "{{baseUrl}}/api/fields/agents"
        }
      },
      {
        "name": "Refresh Token",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"token\": \"{{refreshToken}}\"\n}"
          },
          "url": "{{baseUrl}}/api/auth/refresh"
        }
      },
      {
        "name": "Logout",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"token\": \"{{refreshToken}}\"\n}"
          },
          "url": "{{baseUrl}}/api/auth/logout"
        }
      }
    ]
  }